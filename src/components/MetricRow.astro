---
interface Props {
  items: {
    label: string;
    value: string;
    /** 확인되지 않은 값임을 알리는 문구. 확인된 값에는 넘기지 않는다. */
    note?: string;
  }[];
}

const { items } = Astro.props;
---

<dl class="metrics">
  {items.map((i) => (
    <div>
      <dt>{i.label}</dt>
      {/*
        주석은 dd 안에 둔다. dl > div 는 dt/dd 만 직접 자식으로 허용하므로
        형제로 p 를 두면 axe 의 definition-list 규칙이 깨진다.
        표시는 색이 아니라 글자로 한다 — 색만으로는 전달되지 않는다.
      */}
      <dd>
        <span class="num">{i.value}</span>
        {i.note && <span class="note">{i.note}</span>}
      </dd>
    </div>
  ))}
</dl>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--c-line);
    margin: calc(var(--unit) * 4) 0;
  }

  .metrics > div {
    padding: calc(var(--unit) * 2) 0;
    border-bottom: 1px solid var(--c-line);
  }

  dt {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  dd {
    margin: 4px 0 0;
  }

  dd .num {
    display: block;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .note {
    display: block;
    margin-top: 2px;
    font-size: 0.6875rem;
    line-height: 1.3;
    font-weight: 400;
    color: var(--c-warn);
  }
</style>
