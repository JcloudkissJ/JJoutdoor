---
// Redirect to /en/ for static builds that don't support Astro.redirect()
// Astro.redirect() is SSR-only; with output: 'static', we use HTML meta refresh
// with a visible fallback link for accessibility and JavaScript-disabled clients
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting to English</title>
    <meta http-equiv="refresh" content="0; url=/en/" />
  </head>
  <body>
    <p><a href="/en/">Continue to English version</a></p>
  </body>
</html>
