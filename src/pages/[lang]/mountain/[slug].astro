---
import { getCollection } from 'astro:content';
import { LIVE_LANGUAGES } from '../../../config/languages';
import { resolveText, makeTranslator } from '../../../lib/i18n';
import Base from '../../../layouts/Base.astro';
import MetricRow from '../../../components/MetricRow.astro';
import ProvenanceBlock from '../../../components/ProvenanceBlock.astro';
import HazardCard from '../../../components/HazardCard.astro';
import en from '../../../i18n/en.json';

export async function getStaticPaths() {
  const places = await getCollection('places', (p) => p.data.type === 'mountain');
  return LIVE_LANGUAGES.flatMap((l) =>
    places.map((p) => ({ params: { lang: l.code, slug: p.data.id }, props: { place: p.data } })),
  );
}

const { lang, slug } = Astro.params;
const { place } = Astro.props;

const dict = (await import(`../../../i18n/${lang}.json`)).default;
const t = makeTranslator(en, dict);

const name = place.name_i18n[lang!] ?? place.name_i18n.en;
const { value: text, isFallback } = resolveText(place.text, lang!);
const hours = Math.floor(place.metrics.duration_min / 60);
const mins = place.metrics.duration_min % 60;
const timeFormatKey = mins === 0 ? 'time.h' : 'time.hm';
const durationValue = t(timeFormatKey).replace('{h}', String(hours)).replace('{m}', String(mins));

// 확인된 값에는 아무것도 붙이지 않고, 계산했거나 검증되지 않은 값에만 표시한다.
// sourced 는 기관 데이터라 별도 표시가 필요 없다 — 출처는 아래 ProvenanceBlock 이 밝힌다.
type MetricKey = keyof typeof place.metrics_origin;
const originNote = (key: MetricKey): string | undefined => {
  const origin = place.metrics_origin[key];
  // 출처가 null 이면 값도 null 이다(스키마가 짝을 강제한다). 없는 값의 출처를 말할 수는
  // 없으므로, 대신 왜 비었는지를 말한다.
  if (origin === null) return t('metric.unknown');
  if (origin.kind === 'estimated') return t('metric.estimated');
  if (origin.kind === 'manual') return t('metric.unverified');
  return undefined;
};

// 출처가 거리를 주지 않은 코스가 있다. 빈칸을 숫자로 메우지 않는다.
const distanceValue = place.metrics.distance_km === null ? '—' : `${place.metrics.distance_km} km`;
---

<Base lang={lang!} title={name} description={text.summary} path={`/mountain/${slug}`}>
  <article class="wrap">
    <h1>{name}</h1>
    {isFallback && <p class="fallback">{t('fallback.notice')}</p>}
    <p class="lede">{text.summary}</p>

    <MetricRow
      items={[
        { label: t('metric.elevation'), value: `${place.metrics.elevation_m} m`, note: originNote('elevation_m') },
        { label: t('metric.distance'), value: distanceValue, note: originNote('distance_km') },
        { label: t('metric.duration'), value: durationValue, note: originNote('duration_min') },
      ]}
    />

    <ul class="cautions">
      <li>{text.caution1}</li>
      <li>{text.caution2}</li>
    </ul>

    {place.safety.hazards.map((h) => <HazardCard id={h} lang={lang!} />)}

    {place.access.signage_langs === null && <p class="warn">{t('signage.unknown')}</p>}

    <ProvenanceBlock
      sources={place.provenance.sources}
      status={place.provenance.verification.status}
      t={t}
    />
    <p class="disclaimer">{t('disclaimer')}</p>
  </article>
</Base>

<style>
  .wrap {
    max-width: var(--measure);
    margin: 0 auto;
    padding: calc(var(--unit) * 6) calc(var(--unit) * 2);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.25rem);
    line-height: 1.1;
    margin: 0;
  }

  .lede {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--c-fg-muted);
  }

  .fallback {
    font-size: 0.8125rem;
    color: var(--c-warn);
  }

  .warn {
    color: var(--c-warn);
    font-weight: 600;
  }

  .cautions {
    padding-left: 1.2em;
    line-height: 1.7;
  }

  .disclaimer {
    font-size: 0.75rem;
    color: var(--c-fg-muted);
    margin-top: calc(var(--unit) * 4);
  }
</style>
