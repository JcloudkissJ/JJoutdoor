---
import { getCollection } from 'astro:content';
import { LIVE_LANGUAGES } from '../../config/languages';
import { resolveText, makeTranslator } from '../../lib/i18n';
import Base from '../../layouts/Base.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import en from '../../i18n/en.json';

export async function getStaticPaths() {
  return LIVE_LANGUAGES.map((l) => ({
    params: { lang: l.code },
  }));
}

const { lang } = Astro.params;

const dict = (await import(`../../i18n/${lang}.json`)).default;
const t = makeTranslator(en, dict);

// Load places, filter to Seoul + half-day duration
const places = await getCollection('places');
const filteredPlaces = places.filter(
  (p) => p.data.region.sido === '11' && p.data.metrics.duration_min <= 150
);

// Map place data to CardData format
const placeCards = filteredPlaces.map((place) => {
  const name = place.data.name_i18n[lang!] ?? place.data.name_i18n.en;
  const { value: text } = resolveText(place.data.text, lang!);

  // Format duration
  const hours = Math.floor(place.data.metrics.duration_min / 60);
  const mins = place.data.metrics.duration_min % 60;
  const timeFormatKey = mins === 0 ? 'time.h' : 'time.hm';
  const durationValue = t(timeFormatKey).replace('{h}', String(hours)).replace('{m}', String(mins));

  // Determine if signage has English
  const hasEnglishSignage = place.data.access.signage_langs?.includes('en') ?? null;

  // Get transit info (station name and walk time)
  const stationName = place.data.access.transit?.station_i18n?.[lang!] ?? place.data.access.transit?.station_i18n?.en ?? null;
  const walkMin = place.data.access.transit?.walk_min ?? null;

  return {
    place,
    name,
    summary: text.summary,
    // 규칙 9 — URL 은 /{lang}/{type}/{slug} 다. 접두어를 빼면 404 가 난다.
    href: `/${lang}/mountain/${place.data.id}`,
    difficulty: place.data.metrics.difficulty,
    difficultyLabel: t(`difficulty.${place.data.metrics.difficulty}`),
    region: place.data.region.sido,
    durationMin: place.data.metrics.duration_min,
    signageEn: hasEnglishSignage,
    restroom: place.data.access.restroom,
    stationName,
    walkMin,
    metrics: [
      // 출처가 거리를 주지 않은 코스가 있다. 빈칸을 숫자로 메우지 않는다.
      { label: t('metric.distance'), value: place.data.metrics.distance_km === null ? '—' : `${place.data.metrics.distance_km} km` },
      { label: t('metric.elevation'), value: `${place.data.metrics.elevation_m} m` },
      { label: t('metric.duration'), value: durationValue },
    ],
  };
});

const title = t('half_day.title');
const description = t('half_day.description');
---

<Base lang={lang!} title={title} description={description} path="/half-day-from-seoul/">
  <div class="container">
    <h1>{title}</h1>

    <div id="results">
      {placeCards.map((pc) => (
        <div class="result-item">
          {pc.stationName && pc.walkMin !== null && (
            <p class="transit-info">
              {t('transit.walk_from').replace('{min}', String(pc.walkMin)).replace('{station}', pc.stationName)}
            </p>
          )}
          <PlaceCard
            href={pc.href}
            name={pc.name}
            summary={pc.summary}
            difficultyLabel={pc.difficultyLabel}
            difficulty={pc.difficulty}
            region={pc.region}
            durationMin={pc.durationMin}
            signageEn={pc.signageEn}
            restroom={pc.restroom}
            metrics={pc.metrics}
          />
        </div>
      ))}
    </div>
  </div>
</Base>

<style>
  .container {
    max-width: var(--measure);
    margin: 0 auto;
    padding: calc(var(--unit) * 6) calc(var(--unit) * 2);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.25rem);
    line-height: 1.1;
    margin: 0 0 calc(var(--unit) * 4) 0;
  }

  .result-item {
    margin-bottom: calc(var(--unit) * 2);
  }

  .transit-info {
    margin: 0 0 calc(var(--unit) * 1) 0;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--c-accent);
  }
</style>
