# 이 파일을 .env 로 복사한 뒤 인증키를 채운다.
#
#   cp .env.example .env
#
# .env 는 절대 커밋하지 않는다(.gitignore 대상). 이 예시 파일만 커밋한다.

# ── 공공데이터포털 인증키 ──────────────────────────────────────────
# data.go.kr 은 계정당 "일반 인증키" 하나를 발급하고, 활용신청이 승인된
# 모든 서비스가 그 키 하나를 공유한다. 서비스마다 다른 키가 아니다.
#
# 발급: data.go.kr 로그인 → 각 서비스 페이지 → 활용신청(자동승인)
#       → 마이페이지 > 인증키 발급현황 > 일반 인증키
#
# 주의: 포털은 Encoding/Decoding 두 형태를 준다. HTTP 클라이언트가 쿼리스트링을
# 다시 인코딩하면 이중 인코딩으로 인증 실패가 나므로, 어느 쪽을 넣었는지 알고 써야 한다.
DATA_GO_KR_KEY=

# ── 엔드포인트 (비밀 아님) ────────────────────────────────────────
# 값이 고정이라 코드에 박아도 되지만, 기관이 경로를 바꾸는 일이 있어
# 설정으로 빼둔다.

# 한국등산트레킹지원센터 — 100대명산 목록정보
EP_TOP100=https://apis.data.go.kr/B553662/top100FamtListBasiInfoService

# 한국등산트레킹지원센터 — 전국주요봉우리 위험지역 POI
# safety.hazards 의 근거 후보. 현재 hazards 값은 자체 작성이라 출처가 없다.
EP_DANGER_POI=https://apis.data.go.kr/B553662/dangerInfoService

# 한국등산트레킹지원센터 — 전국주요봉우리 건강효과 POI
EP_HEALTH_POI=https://apis.data.go.kr/B553662/hlthEffctInfoService

# 산림청 국립산림과학원 — 산악기상정보
# Phase 1 스키마에는 대응 필드가 없다. 계절별 안전 가이드와 연결 가능.
EP_MT_WEATHER=https://apis.data.go.kr/1400377/mtweather

# 미발급: 기상청 산악예보 (활용신청 대기)
# EP_MT_FORECAST=
